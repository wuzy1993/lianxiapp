page {
  background: #f4f5f7;
  font-size: 28rpx;
  color: #111827;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}
.card {
  background: #ffffff;
  border-radius: 20rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.04);
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
}
.row + .row {
  border-top: 1rpx solid #f1f2f4;
}
.label {
  font-size: 28rpx;
  color: #374151;
}
.value {
  color: #6b7280;
  font-size: 28rpx;
}
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 10rpx 0 16rpx;
}
.chip {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 26rpx;
}
.chip.on {
  background: #eef2ff;
  color: #4f46e5;
  font-weight: 600;
  border: 1rpx solid #c7d2fe;
}
.seg {
  display: flex;
  background: #f3f4f6;
  border-radius: 16rpx;
  padding: 6rpx;
  margin: 8rpx 0 18rpx;
}
.seg view {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 12rpx;
  color: #6b7280;
  font-size: 26rpx;
}
.seg view.on {
  background: #ffffff;
  color: #111827;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.1);
}
.btn {
  margin: 16rpx 24rpx;
  height: 88rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
}
.btn-primary {
  background: #4f46e5;
  color: #ffffff;
}
.btn-plain {
  background: #ffffff;
  color: #374151;
  border: 1rpx solid #e5e7eb;
}
.footer-note {
  text-align: center;
  color: #9ca3af;
  font-size: 24rpx;
  padding: 8rpx 0 60rpx;
  line-height: 1.7;
}
